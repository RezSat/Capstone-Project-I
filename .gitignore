# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production
/build

# caches and logs
.cache/
.turbo/
*.cache
*.log

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
